{
  "name": "@trucoit/cdk-cloudfront-proxy",
  "version": "0.1.0",
  "description": "AWS CDK construct for a serverless CloudFront reverse proxy using Lambda",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rm -rf lib",
    "prepare": "npm run build",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map"
  ],
  "keywords": [
    "aws",
    "cdk",
    "cloudfront",
    "lambda",
    "proxy",
    "serverless",
    "construct"
  ],
  "author": "dsapab",
  "license": "MIT",
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
